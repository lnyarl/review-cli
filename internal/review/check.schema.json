{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets_checked",
    "conclusion",
    "evidence",
    "not_checked",
    "findings"
  ],
  "properties": {
    "targets_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "issue",
        "no_issue",
        "cannot_determine"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_checked": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "confidence",
          "file",
          "line",
          "condition",
          "code_path",
          "impact",
          "evidence",
          "scope"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "condition": {
            "type": "string"
          },
          "code_path": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "in",
              "out_of_scope"
            ]
          }
        }
      }
    }
